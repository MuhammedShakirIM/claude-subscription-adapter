# Copy this file to .env and adjust values. The adapter loads .env from its working directory on startup.
# Do not commit .env: it can contain CSA_API_KEY.

# HTTP server. CSA_API_KEY is optional on localhost but required for a non-loopback CSA_HOST.
CSA_HOST=127.0.0.1
CSA_PORT=9001
# CSA_API_KEY=replace-with-a-long-random-secret

# JSON object mapping public model aliases to Claude Code model IDs.
# Then application code can request model="sonnet" or model="opus".
# Replace these IDs if your Claude Code account exposes a different catalog.
CSA_MODELS='{"sonnet":"claude-sonnet-5-5","opus":"claude-opus-5-5"}'

# Claude Code executable and neutral working directory. Empty CLAUDE_CODE_CWD uses the system temporary directory.
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_CWD=

# Per-request CLI limits.
CLAUDE_CODE_TIMEOUT_SECONDS=600
CLAUDE_CODE_MAX_OUTPUT_TOKENS=32000
CLAUDE_CODE_MAX_CONCURRENCY=4
CLAUDE_CODE_MAX_QUEUE_LENGTH=20

# Optional session-resume cleanup window, in seconds.
CLAUDE_CODE_SESSION_INACTIVITY_WINDOW_SECONDS=14400
